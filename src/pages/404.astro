---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 Not Found">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <h1 class="text-6xl font-bold text-gray-200 mb-4">404</h1>
    <p class="text-xl text-gray-700 mb-2">ページが見つかりません</p>
    <a href="/" class="px-6 py-3 bg-gray-50 text-gray-600 hover:text-blue-700 transition-colors hover:underline">
      トップページへ戻る
    </a>
  </div>
</Layout>
