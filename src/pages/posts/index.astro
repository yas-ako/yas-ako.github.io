---
import { getCollection } from "astro:content";

import ArticleItem from "../../components/ArticleItem.astro";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf(),
);
---

<Layout>
  <main class="mx-auto py-8">
    <h1 class="text-2xl font-bold mb-8">記事の一覧</h1>
    <ul class="space-y-4">
      {posts.map((post) => <ArticleItem post={post} />)}
    </ul>
  </main>
</Layout>
