---
import Image from "astro/components/Image.astro";
import { getCollection } from "astro:content";

import yasakoIcon from "../assets/icon.jpg?url";
import ArticleItem from "../components/ArticleItem.astro";
import Layout from "../layouts/Layout.astro";


const posts = (await getCollection("posts"))
  .sort((a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf())
  .slice(0, 3);
---

<Layout>
  <main class="py-8">
    <section class="mb-12 flex items-center justify-center gap-8 text-center">
      <Image src={yasakoIcon} alt="" width={100} height={100} class="rounded-full"
      />
      
      <div>
        <h1 class="text-4xl font-bold">Yasako</h1>
      </div>
    </section>

    <section class="mb-12">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold">投稿</h2>
        <a href="/posts" class="text-blue-600 hover:underline">
          投稿の一覧 →
        </a>
      </div>

      <ul class="space-y-4">
        {posts.map((post) => <ArticleItem post={post} />)}
      </ul>
    </section>
  </main>
</Layout>
