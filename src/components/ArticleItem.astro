---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
---

<li>
  <a href={`/posts/${post.id}`} class="block group p-4 bg-gray-50">
    <h3
      class="text-xl font-semibold group-hover:text-blue-600 transition-colors mb-1"
    >
      {post.data.title}
    </h3>
    <div class="flex flex-col sm:flex-row items-end gap-2 sm:gap-4 text-gray-500">
      <time datetime={post.data.createdAt.toISOString()} class="text-xs">
        {
          post.data.createdAt.toLocaleDateString("ja-JP", {
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
          })
        }
      </time>
      <p class="text-sm">{post.data.description}</p>
    </div>
  </a>
</li>
